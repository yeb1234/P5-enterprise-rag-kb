# ============ 基础 ============
APP_NAME=enterprise-kb
ENV=dev
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ============ 安全（生产必须替换，密钥不要进代码库） ============
JWT_SECRET_KEY=change-me-in-production-with-a-32-byte-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_PER_MINUTE=120

# ============ PostgreSQL（业务元数据 / 全文检索 / 审计 / 报表） ============
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=kb
POSTGRES_PASSWORD=kb_dev_pwd
POSTGRES_DB=kb
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ============ Redis（缓存 / 限流 / Celery broker + result / 进度 pub-sub） ============
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_DB=0
REDIS_BROKER_DB=1
REDIS_RESULT_DB=2

# ============ Milvus（语义向量） ============
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=kb_chunks
MILVUS_NUM_PARTITIONS=32

# ============ 对象存储（原始文件 / 分片 / 版本快照） ============
STORAGE_BACKEND=minio          # minio | local（本地仅用于无 Docker 的学习调试）
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=kb_minio
MINIO_SECRET_KEY=kb_minio_pwd
MINIO_BUCKET=kb-documents
MINIO_SECURE=false
LOCAL_STORAGE_DIR=./.data/objects

# ============ LLM：外部 DeepSeek，不部署本地模型 ============
# 用户所说的 "deepseek v4.1 flash" 对应官方 model id：deepseek-flash（V4.1-Flash-1017）
# 另一个可选模型：deepseek-v4-pro。base_url 不要带 /v1。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_THINKING=disabled    # disabled | enabled
LLM_FALLBACK_TO_EXTRACTIVE=true  # 无 API Key 时退化为「只返回检索片段」，骨架仍可跑通

# ============ Embedding：DeepSeek 官方 API 不提供 embeddings ============
# 语义检索必须单独配一个外部 embedding 服务（OpenAI 兼容 /chat 之外的 /embeddings）。
EMBEDDING_PROVIDER=stub       # stub | openai_compatible
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32
# stub 是确定性伪向量，仅用于离线跑通链路，禁止用于效果评估或生产。

# ============ 上传与异步流水线 ============
MAX_UPLOAD_SIZE_MB=2048
UPLOAD_CHUNK_SIZE_MB=8
UPLOAD_SESSION_TTL_HOURS=48
MAX_BATCH_FILES=200
MAX_CHUNK_CONCURRENCY=4          # 单文件前端并发分片数
LARGE_FILE_PAGE_THRESHOLD=200    # 超过该页数拆页级子任务
LARGE_FILE_SIZE_MB=100           # 超过该体积走 heavy 队列
PARSE_PAGE_BATCH=40              # 每个页级子任务处理的页数
MAX_CONCURRENT_INGEST_PER_TENANT=4
PROGRESS_THROTTLE_SECONDS=0.5    # PG 落库节流，Redis 实时推送不节流
SSE_HEARTBEAT_SECONDS=15
INGEST_MAX_RETRIES=3
INGEST_SOFT_TIME_LIMIT=600
INGEST_HARD_TIME_LIMIT=900

# ============ 分块 ============
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=150

# ============ 前端 ============
VITE_API_BASE_URL=/api/v1
