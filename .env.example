# ============ 基础 ============
APP_NAME=enterprise-kb
ENV=dev
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ============ 安全（生产必须替换，密钥不要进代码库） ============
JWT_SECRET_KEY=change-me-in-production-with-a-32-byte-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_PER_MINUTE=120

# ============ 只读知识库 MCP（P5 对外给 P10 使用） ============
MCP_ENABLED=false
MCP_SERVICE_KEY=change-me-with-a-random-service-key
MCP_TENANT_ID=
MCP_USER_ID=

# ============ PostgreSQL（业务元数据 / 全文检索 / 审计 / 报表） ============
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=kb
POSTGRES_PASSWORD=kb_dev_pwd
POSTGRES_DB=kb
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ============ Redis（缓存 / 限流 / Celery broker + result / 进度 pub-sub） ============
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_DB=0
REDIS_BROKER_DB=1
REDIS_RESULT_DB=2

# ============ Milvus（语义向量） ============
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=kb_chunks
MILVUS_NUM_PARTITIONS=32

# ============ 对象存储（原始文件 / 分片 / 版本快照） ============
STORAGE_BACKEND=minio          # minio | local（本地仅用于无 Docker 的学习调试）
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=kb_minio
MINIO_SECRET_KEY=kb_minio_pwd
MINIO_BUCKET=kb-documents
MINIO_SECURE=false
LOCAL_STORAGE_DIR=./.data/objects

# ============ LLM：外部 DeepSeek，不部署本地模型 ============
# 用户所说的 "deepseek v4.1 flash" 对应官方 model id：deepseek-flash（V4.1-Flash-1017）
# 另一个可选模型：deepseek-v4-pro。base_url 不要带 /v1。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_THINKING=disabled    # disabled | enabled
LLM_FALLBACK_TO_EXTRACTIVE=true  # 无 API Key 时退化为「只返回检索片段」，骨架仍可跑通

# ============ Embedding：DeepSeek 官方 API 不提供 embeddings ============
# 语义检索必须单独配一个外部 embedding 服务（OpenAI 兼容 /chat 之外的 /embeddings）。
EMBEDDING_PROVIDER=stub       # stub | openai_compatible
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32
# stub 是确定性伪向量，仅用于离线跑通链路，禁止用于效果评估或生产。

# ============ 上传与异步流水线 ============
MAX_UPLOAD_SIZE_MB=2048
UPLOAD_CHUNK_SIZE_MB=8
UPLOAD_SESSION_TTL_HOURS=48
MAX_BATCH_FILES=200
MAX_CHUNK_CONCURRENCY=4          # 单文件前端并发分片数
LARGE_FILE_PAGE_THRESHOLD=200    # 超过该页数拆页级子任务
LARGE_FILE_SIZE_MB=100           # 超过该体积走 heavy 队列
PARSE_PAGE_BATCH=40              # 每个页级子任务处理的页数
MAX_CONCURRENT_INGEST_PER_TENANT=4
PROGRESS_THROTTLE_SECONDS=0.5    # PG 落库节流，Redis 实时推送不节流
SSE_HEARTBEAT_SECONDS=15
INGEST_MAX_RETRIES=3
INGEST_SOFT_TIME_LIMIT=600
INGEST_HARD_TIME_LIMIT=900

# ============ 分块 ============
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=150

# ============ 前端 ============
VITE_API_BASE_URL=/api/v1

# ============ 演示切片 webapp（与 backend 骨架命名空间隔离） ============
# webapp/ 是 SQLite + 进程内队列的演示替身，与上面的生产骨架配置互不共用。
# WEBAPP_ 前缀不可去掉：backend 的 EMBEDDING_PROVIDER 枚举为 stub|openai_compatible，
# 与 webapp 的 offline|local|external 互斥，同名会让 backend 启动校验失败。
WEBAPP_LLM_PROVIDER=discovery
WEBAPP_EMBEDDING_PROVIDER=external
WEBAPP_RERANK_PROVIDER=external
# 低思考 / 快速档：V4.1 系列默认先输出 reasoning，这里显式关闭以降低首 token 延迟。
# disabled | enabled；与 backend 的 DEEPSEEK_THINKING 同义，但命名空间独立。
WEBAPP_LLM_THINKING=disabled
DISCOVERY_BASE_URL=https://discovery-api.intern-ai.org.cn/v1
DISCOVERY_API_KEY=
DISCOVERY_MODEL=deepseek-v4.1-flash-1017
EXTERNAL_EMBED_BASE_URL=https://api.siliconflow.cn/v1
EXTERNAL_EMBED_MODEL=BAAI/bge-m3
EXTERNAL_RERANK_BASE_URL=https://api.siliconflow.cn/v1
EXTERNAL_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API_KEY=
# 向量排序后端：pgvector（默认，主链路走库里的 embedding 列 + HNSW）| python（历史实现，回滚用）
# 改动前先确认库里有 vector 扩展与 embedding 列，否则 mode 会显示 pgvector_fallback_python:XXX
WEBAPP_VECTOR_BACKEND=pgvector

# ============ 可插拔文档解析（parsing/ 与 compose 的 parser 服务） ============
# 三级：P0 自研 local（零依赖）→ P1 收费 OCR / 版面解析 → P2 多模态 LLM 传图兜底
# auto 按质量门禁确定性升级；0.10 是最贵链路的页数上限/熔断线，不是随机分流
PARSING_STRATEGY=auto              # auto | local_only | ocr_api | multimodal | off
PARSING_VISION_ESCALATION_RATIO=0.10
PARSING_VISION_MIN_SLOTS=1
PARSING_CONFIDENCE_MIN=0.75
PARSING_OCR_TEXT_CHARS_MIN=40
PARSING_TABLE_FAIL_RATIO=0.4
PARSING_IMAGE_ENTROPY_MIN=7.2
# 总离线开关：设为 1 时 P1/P2 全部跳过、零外部请求（单测与流量不足时用）
PARSING_OFFLINE=0
# 只关视觉层（不影响 P1 契约检查）
PARSING_VISION_ENABLED=1
# 低思考档：实测 thinking={"type":"disabled"} 把 reasoning_tokens 从 55 降到 0、
# 耗时 979ms → 467ms；元数据里的布尔 reasoning 参数实测无效
PARSING_VISION_LOW_THINKING=1
PARSING_VISION_TIMEOUT_S=60

# P2 已接通：2026-11-14 实测网关 /models 的 input_modalities 显示 10 个模型中
# 6 个支持 image；deepseek-v4.1-flash-1017 双图对照传图实测通过。
# 因此默认复用上面的 DISCOVERY_BASE_URL / API_KEY / MODEL，无需再补凭证。
# 下面三项留空即走该回退；要换成别的视觉端点时再显式填写。
PARSING_VISION_BASE_URL=
PARSING_VISION_API_KEY=
PARSING_VISION_MODEL=

# P1 收费 OCR 仍未接通：接口地址 / 鉴权 / 请求响应结构 / 配额 / 错误码 /
# 价格一律 __TBC__，不得推断填写。留空时适配器判定不可用并优雅降级留痕。
PARSING_OCR_BASE_URL=
PARSING_OCR_API_KEY=
PARSING_OCR_MODEL=

# ---- 运行日志（v1.3.2）----
# 级别：DEBUG / INFO / WARNING / ERROR。默认 INFO。
# 访问日志一行一个 JSON 到 stdout；容器侧上限由 run-demo.sh 的
# --log-opt max-size=10m --log-opt max-file=3 控制（不配就是无限长，会写满磁盘）。
WEBAPP_LOG_LEVEL=INFO
# 静默路径：这些路径在状态码 < 400 时只写 DEBUG。
# 默认值包含 / 是因为 Docker HEALTHCHECK 每 30 秒打一次，不降级一天 2880 行噪声。
# 要临时看健康检查：把级别调到 DEBUG，或把 "/" 从这个列表里去掉。
WEBAPP_ACCESS_LOG_QUIET_PATHS=/,/health/live,/metrics

# ---- 三路取证（v1.3.3）----
# 每路一个开关：on / off。默认只开向量一路，与引入三路之前的行为一致。
# 也可以在「模型设置 → 检索路由」页面（admin）改，落 app_settings，即时生效。
WEBAPP_RAG_ROUTE_VECTOR=on
WEBAPP_RAG_ROUTE_GRAPH=off
WEBAPP_RAG_ROUTE_WIKI=off
# 图谱：跳数上限 1/2/3；查询生成 template（手写，零模型调用）| llm（自己写的 Text2Cypher）；
# 建图抽取 offline（术语共现）| llm（带类型语义关系，每批一次模型调用）
WEBAPP_RAG_GRAPH_HOPS=2
WEBAPP_RAG_GRAPH_CYPHER=template
WEBAPP_RAG_GRAPH_EXTRACTOR=offline
# Neo4j：默认不启动。要用图谱先执行：
#   docker compose -f docker-compose.infra.yml --profile graphrag up -d neo4j
# 连接信息只从环境变量注入，不进 app_settings、不进仓库。
WEBAPP_NEO4J_URI=bolt://kb-neo4j:7687
WEBAPP_NEO4J_AUTH=neo4j/kb_demo_only
# LLM Wiki：业务场景必须填好才有整理口径；陈旧文档占比上限 0-1。
# 场景未定 / 信源变了 / 有过期文档，任一命中则 Wiki 这一路不启动（报告写明原因）。
WEBAPP_WIKI_SCENARIO=
WEBAPP_WIKI_STALE_RATIO_MAX=0.1
