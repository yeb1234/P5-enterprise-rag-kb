{
  "scenario_id": "DEMO-KBQA-EVAL-001",
  "scenario_version": "1.0.0",
  "title": "一次说明书分块问答评测：从开场到结果确认",
  "subtitle": "离线占位档位的完整演示闭环",
  "profile": "offline_placeholder",
  "duration_minutes": 12,
  "audience": "内部技术评审 / 求职作品讲解 / 团队新人培训",
  "presenter": "演示者（单人，无需协助）",
  "goal": "用一条可复现的主线证明：六链路跑得通、每一步可追溯、异常不静默、结果可确认。",
  "success_criteria": "演示者照着文档念、按命令敲，观众看到的实际输出与文档预期逐项一致；不需要任何真实 API、密钥或网络。",
  "boundary_statement": "本演示只证明链路与工程约束，不证明检索/生成质量；所有质量指标 comparable=false，质量阈值未冻结。",
  "story": "评审现场，演示者要回答一个问题：这套评测体系到底能不能独立跑起来、结果敢不敢信。演示者从场景卡开始，先亮出契约门禁说明「没接真实 API 也不会假装能评」，列出 14 个版本化对象，跑一次全量批次，挑一条正常用例逐链路核对，再故意展示三类边界情况证明异常不静默，做一次对比实验说明可比较性边界，最后用 manifest 的四个哈希完成结果确认。",

  "glossary": {
    "六链路": "chunk → embed → retrieve → assemble_prompt → generate → score",
    "占位档位": "offline_placeholder，禁止网络、只用确定性占位实现",
    "契约槽位": "OBJ-ADAPTER-CONTRACTS 中预留的 __TBC__ 接入字段",
    "版本化对象": "独立可标识、带版本/生效范围/依赖/变更记录的配置单元",
    "统一记录": "eval-record/v0.1 逐用例 JSONL 记录 + manifest + summary",
    "两端对齐": "演示侧 demo_run_result.json 与验证侧 eval 产物逐字段一致",
    "不静默": "异常/评分不可用必须记录状态与原因，不得记 0 分或丢弃用例",
    "可比较性": "comparable=false 表示占位结果不得用于质量结论"
  },
  "required_terms": ["offline_placeholder", "OFFLINE_READY", "NOT_COMPARABLE", "comparable=false", "__TBC__", "eval-record/v0.1", "config_snapshot_hash", "code_hash", "dataset_hash", "object_versions"],
  "forbidden_terms": ["准确率已达", "生产可用", "已上线", "真实模型实测", "召回率提升百分之"],

  "constants": {
    "object_count": 14,
    "case_count": 26,
    "contract_total": 35,
    "blocking_contract_count": 26,
    "optional_contract_count": 9,
    "chain_step_count": 6,
    "chain_steps": ["chunk", "embed", "retrieve", "assemble_prompt", "generate", "score"],
